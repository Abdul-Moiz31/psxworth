engine-strict=true

# Hoist drizzle-orm to root node_modules to ensure TypeScript resolves it as a single module
# This fixes type incompatibility errors when using both drizzle-orm/libsql/web and drizzle-orm/postgres-js
# in the same project, as pnpm's nested structure can cause TypeScript to see different module paths
# even though they point to the same code, leading to "separate declarations" type errors.
public-hoist-pattern[]=*drizzle-orm*